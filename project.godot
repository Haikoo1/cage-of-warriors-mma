; Projeto Jaula — configuração do projeto Godot.
; Decisões: T-001 (versão 4.7.2), T-011 (pixel-perfect), T-008 (autoloads), T-002 (tipagem).

config_version=5

[application]

config/name="Projeto Jaula"
config/version="0.0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

DataRegistry="*res://src/app/autoload/data_registry.gd"
Settings="*res://src/app/autoload/settings.gd"
SceneRouter="*res://src/app/autoload/scene_router.gd"
AudioDirector="*res://src/app/autoload/audio_director.gd"
GameSession="*res://src/app/autoload/game_session.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
